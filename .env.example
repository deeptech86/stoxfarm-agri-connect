# API Configuration
# Development example:
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Production example (if different from same-origin /api/v1):
# VITE_API_URL=https://api.stoxxfarm.in/api/v1

# App Configuration
VITE_APP_NAME=StoxxFarm
VITE_APP_VERSION=1.0.0

# Firebase Configuration (Get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# VAPID Key (Get from Firebase Console -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=your_vapid_key
